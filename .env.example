# Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git (already in .gitignore)

# Stripe Configuration (REQUIRED for payment system)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# Formspree Configuration
FORMSPREE_FORM_ID=your_form_id_here

# Analytics (Optional - Privacy-first recommended)
# PLAUSIBLE_DOMAIN=goodflippindesign.com
# or
# FATHOM_SITE_ID=your_site_id

# Error Tracking (Optional)
# SENTRY_DSN=your_sentry_dsn

# Cloudflare Configuration (for deployment)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
CLOUDFLARE_PROJECT_NAME=good-flippin-design

# Development
NODE_ENV=development
