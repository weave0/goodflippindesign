  "updated_at": "2026-09-22",
  "purpose": "Authoritative inventory boundary for GFD operator products. A governed property may be unknown, but it may not be silently absent.",
  "source_notes": [
    "The governed zone inventory is reconciled against CF_EXPECTED_ZONES in .github/workflows/traffic-intelligence-deploy.yml.",
    "Brand mappings are asserted only where the zone exactly matches a public brand domain in brands.json.",
    "Unmapped zones remain explicit and unclassified until a human-readable relationship is established."
  ],
  "invariants": {
    "governed_zone_must_be_present": true,
    "public_brand_domain_must_be_present": true,
    "unknown_relationship_must_remain_visible": true,
    "unclassified_must_not_render_as_healthy": true
  },
