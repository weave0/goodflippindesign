{
  "name": "good-flippin-design",
  "version": "1.0.0",
  "description": "Strategic web development portfolio for GFV LLC",
  "scripts": {
    "dev": "npx http-server . -p 3000",
    "sync": "node scripts/sync-review.js",
    "invite:team": "pwsh -File scripts/invite-team.ps1",
    "library:index": "node scripts/generate-library-index.js",
    "test:quick": "npm run sync && node tests/accessibility.test.js",
    "test": "node tests/run-all-tests.js",
    "test:watch": "node --watch-path=index.html --watch-path=temp_review.html --watch-path=tests tests/run-all-tests.js",
    "test:a11y": "node tests/accessibility.test.js",
    "test:responsive": "node tests/responsive.test.js",
    "test:community": "node tests/community.test.js",
    "test:donate": "node tests/donate.test.js",
    "cache-bust": "node scripts/update-cache-bust.js",
    "export:music": "node scripts/export-music-catalog.js",
    "build": "npm run cache-bust && npm run sync && node scripts/stamp-pages-release.mjs",
    "pretest": "npm run sync",
    "prepare": "node -e \"if (!process.env.CI) { require('child_process').execSync('husky install', {stdio: 'inherit'}) }\"",
    "format": "prettier --write \"*.html\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "lint": "eslint .",
    "lint:html": "html-validate index.html",
    "gen:csp": "node scripts/generate-csp.js",
    "gen:csp:dry": "node scripts/generate-csp.js --dry-run",
    "verify:hook-boundary": "node scripts/verify-precommit-hook-boundary.js",
    "deploy:stripe": "wrangler deploy --config workers/wrangler-stripe.toml",
    "stripe:secret": "wrangler secret put STRIPE_SECRET_KEY --config workers/wrangler-stripe.toml",
    "deploy:health-sweep": "wrangler deploy --config workers/wrangler-health-sweep.toml",
    "health-sweep:schema": "wrangler d1 execute gfd_community --remote --file=db/d1-schema-health.sql",
    "health-sweep:secret:github": "wrangler secret put GITHUB_TOKEN --config workers/wrangler-health-sweep.toml",
    "health-sweep:secret:sweep": "wrangler secret put SWEEP_SECRET --config workers/wrangler-health-sweep.toml",
    "health-sweep:trigger": "node -e \"const h=process.env.SWEEP_SECRET||''; fetch('https://gfd-health-sweep.weave0.workers.dev/trigger',{method:'GET',headers:{'x-sweep-secret':h}}).then(r=>r.json()).then(console.log)\"",
    "health-sweep:last": "node -e \"fetch('https://gfd-health-sweep.weave0.workers.dev/last').then(r=>r.json()).then(d=>console.table(d))\"",
    "deploy:mission-control-events": "wrangler deploy --config workers/wrangler-mission-control-events.toml",
    "mission-control-events:schema": "wrangler d1 execute gfd_community --remote --file=db/d1-schema-mission-control-events.sql",
    "deploy:social": "wrangler deploy --config wrangler-social.toml",
    "deploy:cron": "wrangler deploy --config wrangler-cron.toml",
    "cron:apply-schema": "wrangler d1 execute gfd_community --remote --file=db/d1-schema-studio.sql",
    "social:secret:encrypt": "wrangler secret put TOKEN_ENCRYPTION_KEY --config wrangler-social.toml",
    "social:secret:internal": "wrangler secret put INTERNAL_SECRET --config wrangler-social.toml",
    "watermark": "node scripts/watermark.js",
    "watermark:help": "node scripts/watermark.js --list-platforms",
    "cms:schema": "wrangler d1 execute gfd_community --file=db/d1-schema-cms.sql",
    "scan:media": "node scripts/scan-media-drop.js",
    "sweep": "node scripts/local-sweep.js",
    "sweep:quiet": "node scripts/local-sweep.js --quiet",
    "sweep:json": "node scripts/local-sweep.js --json",
    "ecosystem:validate": "node scripts/validate-brands.js",
    "ecosystem:status": "node scripts/ecosystem-status.js",
    "ecosystem:status:json": "node scripts/ecosystem-status.js --json",
    "sweep:schedule": "pwsh -File scripts/schedule-sweep.ps1",
    "sync:art": "node scripts/sync-art-drive.js",
    "sync:art:watch": "node scripts/sync-art-drive.js --watch",
    "sync:art:dry": "node scripts/sync-art-drive.js --dry-run",
    "discover:assets": "node scripts/discover-site-assets.js",
    "discover:assets:dry": "node scripts/discover-site-assets.js --dry-run",
    "finance:help": "pwsh -File scripts/finance/finance-workspace.ps1 -Action help",
    "finance:bootstrap": "pwsh -File scripts/finance/finance-workspace.ps1 -Action bootstrap",
    "finance:init": "pwsh -File scripts/finance/finance-workspace.ps1 -Action init",
    "finance:status": "pwsh -File scripts/finance/finance-workspace.ps1 -Action status",
    "finance:list": "pwsh -File scripts/finance/finance-workspace.ps1 -Action list",
    "finance:inventory": "node scripts/finance/run-finance-tool.js inventory_finance_inputs",
    "finance:package": "node scripts/finance/run-finance-tool.js package_submission",
    "finance:ga4:discover": "node scripts/finance/run-finance-tool.js discover_ga4_properties",
    "finance:ga4:export": "node scripts/finance/run-finance-tool.js export_ga4",
    "finance:ga4:ingest": "node scripts/finance/run-finance-tool.js ingest_ga4_ui_exports",
    "finance:stripe:export": "node scripts/finance/run-finance-tool.js export_stripe",
    "clean": "pwsh -File scripts/clean-node-modules-corruption.ps1 -WhatIf",
    "r2:import": "node scripts/r2-bulk-import.js",
    "r2:import:dry": "node scripts/r2-bulk-import.js --dry-run",
    "analytics": "node scripts/cf-analytics.js",
    "analytics:open": "node scripts/cf-analytics.js && start analytics/dashboard.html",
    "test:workers": "vitest run --config vitest.workers.config.mjs",
    "test:mc-prepare": "node --test tests/workers/fwomps-prepare-issuer.node-test.mjs",
    "test:workers:mission-control-events": "vitest run --config vitest.workers.config.mjs tests/workers/mission-control-events.test.js tests/workers/contact-business-events.test.js",
    "test:workers:mission-control-core": "vitest run --config vitest.workers.config.mjs tests/workers/mission-control-work-items.test.js tests/workers/mission-control-finding-reconciliation.test.js tests/workers/mission-control-outbox.test.js tests/workers/mission-control-operations.test.js tests/workers/mission-control-reverification.test.js",
    "test:security": "node tests/security/audit-policy.test.js && node tests/security/payment-surface.test.js",
    "test:workers:payments": "vitest run --config vitest.stripe-payments.config.mjs",
    "test:workers:stripe-webhook": "vitest run --config vitest.workers.config.mjs tests/workers/stripe.test.js tests/workers/stripe-ledger.test.js",
    "test:workers:social-publisher": "vitest run --config vitest.workers.config.mjs --no-file-parallelism tests/workers/social-publisher.test.js",
    "test:all": "npm test && npm run test:workers && npm run test:workers:payments",
    "traffic:dev": "npm --prefix traffic-intelligence run dev",
    "traffic:test": "npm --prefix traffic-intelligence test",
    "traffic:build": "npm --prefix traffic-intelligence run build",
    "traffic:lint": "npm --prefix traffic-intelligence run lint",
    "estate:validate": "node scripts/validate-estate-registry.mjs",
    "test:workers:mission-control": "vitest run --config vitest.workers.config.mjs --no-file-parallelism tests/workers/mission-control-api.test.js tests/workers/mission-control-result-bridge.test.js tests/workers/mission-control-writer-races.test.js tests/workers/mission-control-confluence.test.js tests/workers/mission-control-lease-authority.test.js tests/workers/mission-control-canary-runner.test.js tests/workers/fwomps-investigation-adapter.test.js tests/workers/fwomps-wire-conformance.test.js tests/workers/worker-provenance.test.js tests/workers/health-sweep.test.js && node tests/mission-control-surface.test.js",
    "test:workers:mission-control-certification": "vitest run --config vitest.workers.config.mjs tests/workers/mission-control-off-proof.test.js tests/workers/mission-control-preflight-surface.test.js",
    "mc:off-proof": "node --no-warnings scripts/mc-production-off-proof.mjs",
    "mc:redeploy": "node --no-warnings scripts/mc-pages-redeploy.mjs",
    "mc:preflight": "node --no-warnings scripts/mc-production-preflight.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/weave0/goodflippindesign"
  },
  "keywords": [
    "portfolio",
    "web-development",
    "accessibility",
    "wcag"
  ],
  "author": "Brett Weaver <brett.l.weaver@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@sentry/cloudflare": "^10.73.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.1",
    "brace-expansion": "^5.0.6",
    "fast-uri": "^3.1.8",
    "undici": "^7.29.1",
    "qs": "^6.15.2",
    "ws": "^8.21.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.14",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "html-validate": "^10.17.0",
    "http-server": "^14.1.1",
    "husky": "^9.0.0",
    "prettier": "^3.9.6",
    "puppeteer": "^24.43.1",
    "sharp": "^0.35.5",
    "vitest": "^4.1.11"
  }
}
