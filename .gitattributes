# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Shell scripts — keep LF even on Windows
*.sh text eol=lf

# PowerShell — allow CRLF on Windows
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# Declare binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.psd binary
*.ai binary
*.fig binary
