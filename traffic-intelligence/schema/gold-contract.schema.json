{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodflippindesign.com/schema/gfd-traffic-intelligence-gold.v1.json",
  "title": "GFD Traffic Intelligence Gold consumer view model",
  "type": "object",
  "required": ["contract", "definitions", "sources", "defaultWindowId", "windows"],
  "properties": {
    "contract": {
      "type": "object",
      "required": ["name", "version", "pipelineVersion", "producedAt", "kind", "notes"],
      "properties": {
        "name": { "const": "gfd-traffic-intelligence-gold" },
        "version": { "type": "string" },
        "pipelineVersion": { "type": "string" },
        "producedAt": { "type": "string" },
        "kind": { "enum": ["fixture", "production"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "definitions": { "type": "array", "minItems": 10 },
    "sources": { "type": "array", "minItems": 6 },
    "defaultWindowId": { "type": "string" },
    "windows": { "type": "object", "minProperties": 1 }
  },
  "$defs": {
    "evidenceState": {
      "enum": ["MEASURED", "SAMPLED", "INFERRED", "ESTIMATED", "UNAVAILABLE", "UNKNOWABLE"]
    },
    "coverageState": {
      "enum": ["COMPLETE", "INCOMPLETE", "MISSING", "NOT_APPLICABLE"]
    },
    "source": {
      "enum": ["cloudflare_edge", "cloudflare_rum", "ga4", "vercel", "first_party", "modeled"]
    },
    "metric": {
      "type": "object",
      "required": [
        "id",
        "label",
        "value",
        "source",
        "grain",
        "evidenceState",
        "coverage",
        "timeWindow",
        "definitionId",
        "pipelineVersion"
      ],
      "properties": {
        "evidenceState": { "$ref": "#/$defs/evidenceState" },
        "coverage": { "$ref": "#/$defs/coverageState" },
        "value": { "type": ["number", "null"] },
        "sampling": { "type": "object" },
        "confidence": {
          "type": "object",
          "properties": {
            "level": { "type": "number" },
            "intervalValid": { "type": "boolean" },
            "lower": { "type": "number" },
            "upper": { "type": "number" }
          }
        },
        "ratio": { "type": "object" },
        "provenance": { "type": "object" },
        "uniqueSemantics": {
          "enum": [
            "source_native_zone_unique",
            "sum_of_zone_uniques",
            "deduplicated_ecosystem_unique",
            "not_unique"
          ]
        }
      }
    }
  }
}
