node_modules/
.wrangler/
*.log
.env
.DS_Store

# Office temp files
~$*.docx
~$*.pptx
~$*.xlsx

# Security - NEVER commit these!
*_SECURE_KEYS/
**/_SECURE_KEYS/

# Development projects (too large for main repo)
GFD Dev Projects/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv-*/
.mypy_cache/

# Large analysis files
PORTFOLIO_ANALYSIS.json
*.json.bak

# Large image files
assets/portfolio/*-hero.png
Brand Assets Development/**/*.png
!Brand Assets Development/**/favicon*.png
!Brand Assets Development/**/apple-touch-icon.png

# Brand Assets (large files - use Git LFS if needed)
Brand Assets Development/Final Assets/**/*.png
Brand Assets Development/Final Assets/**/*.psd
Brand Assets Development/Final Assets/**/*.ai
Brand Assets Development/Final Assets/**/*.fig
Brand Assets Development/Final Assets/**/*.jpg
Brand Assets Development/Final Assets/**/*.jpeg
# Allow small preview PNGs
!Brand Assets Development/Final Assets/**/*-preview-*.png
!Brand Assets Development/Final Assets/**/*-thumb-*.png

# Local Netlify folder
.netlify
