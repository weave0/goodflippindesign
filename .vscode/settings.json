{
  // ============================================
  // DARK MODERN THEME - Space Vibes Edition 🌌
  // No extra extensions needed - built-in dark theme
  // ============================================
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.preferredDarkColorTheme": "Default Dark Modern",

  // ============================================
  // COMPREHENSIVE DARK COLOR CUSTOMIZATION
  // ============================================
  "workbench.colorCustomizations": {
    // ===== BACKGROUNDS (All Dark) =====
    "editor.background": "#0d1117",
    "sideBar.background": "#0d1117",
    "activityBar.background": "#0d1117",
    "statusBar.background": "#0d1117",
    "panel.background": "#0d1117",
    "terminal.background": "#0d1117",
    "titleBar.activeBackground": "#0d1117",
    "titleBar.inactiveBackground": "#0d1117",
    "breadcrumb.background": "#0d1117",
    "input.background": "#0d1117",
    "dropdown.background": "#0d1117",
    "editorWidget.background": "#0d1117",
    "editorHoverWidget.background": "#161b22",
    "editorSuggestWidget.background": "#161b22",
    "debugConsole.background": "#0d1117",
    "tab.inactiveBackground": "#0d1117",
    "tab.activeBackground": "#161b22",

    // ===== FOREGROUND/TEXT (All Bright) =====
    "editor.foreground": "#e6edf3",
    "sideBar.foreground": "#e6edf3",
    "activityBar.foreground": "#58a6ff",
    "statusBar.foreground": "#e6edf3",
    "panel.foreground": "#e6edf3",
    "terminal.foreground": "#e6edf3",
    "editorLineNumber.foreground": "#30363d",
    "editorLineNumber.activeForeground": "#58a6ff",
    "editorIndentGuide.foreground": "#21262d",
    "editorIndentGuide.activeBackground": "#30363d",
    "breadcrumb.foreground": "#8b949e",

    // ===== BORDERS & SEPARATORS =====
    "sideBar.border": "#21262d",
    "editorGroup.border": "#21262d",
    "panel.border": "#21262d",
    "editorOverviewRuler.border": "#21262d",
    "input.border": "#30363d",
    "dropdown.border": "#30363d",
    "statusBar.border": "#21262d",

    // ===== INTERACTIVE ELEMENTS =====
    "button.background": "#238636",
    "button.hoverBackground": "#2ea043",
    "button.foreground": "#ffffff",
    "button.secondaryBackground": "#21262d",
    "button.secondaryHoverBackground": "#30363d",
    "checkbox.background": "#0d1117",
    "checkbox.border": "#30363d",
    "checkbox.foreground": "#e6edf3",

    // ===== SELECTIONS & HIGHLIGHTS =====
    "editor.selectionBackground": "#388bfd33",
    "editor.selectionForeground": "#e6edf3",
    "editor.inactiveSelectionBackground": "#30363d50",
    "editor.selectionHighlightBackground": "#58a6ff22",
    "editor.wordHighlightBackground": "#58a6ff22",
    "editor.wordHighlightStrongBackground": "#58a6ff44",
    "editor.findMatchBackground": "#bf8700",
    "editor.findMatchHighlightBackground": "#bf870044",

    // ===== LIST & TREES =====
    "list.activeSelectionBackground": "#388bfd22",
    "list.activeSelectionForeground": "#58a6ff",
    "list.focusBackground": "#1f6feb22",
    "list.focusForeground": "#e6edf3",
    "list.hoverBackground": "#161b22",
    "list.hoverForeground": "#e6edf3",
    "list.inactiveSelectionBackground": "#30363d33",
    "list.inactiveSelectionForeground": "#c9d1d9",
    "list.inactiveFocusBackground": "#1f6feb22",

    // ===== SCROLLBARS =====
    "scrollbar.shadow": "#010409",
    "scrollbarSlider.background": "#30363d50",
    "scrollbarSlider.hoverBackground": "#30363d80",
    "scrollbarSlider.activeBackground": "#58a6ff99",

    // ===== BRACKETS & PAIRS =====
    "editorBracketMatch.background": "#58a6ff22",
    "editorBracketMatch.border": "#58a6ff50",
    "editorBracketHighlight.foreground1": "#79c0ff",
    "editorBracketHighlight.foreground2": "#a5d6ff",
    "editorBracketHighlight.foreground3": "#79c0ff",
    "editorBracketHighlight.unexpectedBracket.foreground": "#ff7b72",

    // ===== ERRORS & WARNINGS =====
    "editorError.background": "#da3633",
    "editorError.foreground": "#f85149",
    "editorWarning.background": "#d29922",
    "editorWarning.foreground": "#ffd700",
    "editorInfo.background": "#58a6ff",
    "editorInfo.foreground": "#79c0ff",
    "editorHint.foreground": "#79c0ff",

    // ===== DIFF COLORS =====
    "diffEditor.insertedTextBackground": "#2d333b33",
    "diffEditor.removedTextBackground": "#da363333",
    "diffEditor.diagonalFill": "#30363d",

    // ===== ACTIVITY BAR =====
    "activityBar.activeBorder": "#58a6ff",
    "activityBar.inactiveForeground": "#8b949e",
    "activityBarBadge.background": "#ff7b72",
    "activityBarBadge.foreground": "#ffffff",

    // ===== BADGES & NOTIFICATIONS =====
    "badge.background": "#238636",
    "badge.foreground": "#ffffff",
    "notification.background": "#161b22",
    "notification.foreground": "#e6edf3",
    "notification.border": "#30363d",
    "notificationCenter.border": "#30363d",
    "notificationToast.border": "#30363d",

    // ===== TABS =====
    "tab.border": "#21262d",
    "tab.activeBorder": "#58a6ff",
    "tab.activeBorderTop": "#58a6ff",
    "tab.unfocusedActiveBorder": "#30363d",
    "tab.unfocusedActiveBorderTop": "#21262d",
    "tab.lastPinnedBorder": "#21262d",

    // ===== GROUPS & SPLITTERS =====
    "editorGroupHeader.tabsBackground": "#0d1117",
    "editorGroupHeader.tabsBorder": "#21262d",
    "editorGroup.emptyBackground": "#0d1117",

    // ===== HOVER & CONTEXT =====
    "editorHoverWidget.border": "#30363d",
    "editorSuggestWidget.border": "#30363d",
    "editorSuggestWidget.selectedBackground": "#388bfd22",

    // ===== MINIMAP =====
    "minimapSlider.background": "#30363d50",
    "minimapSlider.hoverBackground": "#30363d80",
    "minimapGutter.addedBackground": "#3fb950",
    "minimapGutter.modifiedBackground": "#d29922",
    "minimapGutter.deletedBackground": "#f85149",

    // ===== BREADCRUMBS =====
    "breadcrumb.activeSelectionForeground": "#58a6ff"
  },

  // ============================================
  // EDITOR APPEARANCE
  // ============================================
  "editor.fontSize": 13,
  "editor.lineHeight": 1.6,
  "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.letterSpacing": 0,

  // ============================================
  // TERMINAL
  // ============================================
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontFamily": "'JetBrains Mono', 'Fira Code', 'Courier New', monospace",
  "terminal.integrated.theme": "dark",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell"
    }
  },
  "terminal.ansiBlack": "#30363d",
  "terminal.ansiRed": "#ff7b72",
  "terminal.ansiGreen": "#3fb950",
  "terminal.ansiYellow": "#d29922",
  "terminal.ansiBlue": "#58a6ff",
  "terminal.ansiMagenta": "#bc8ef7",
  "terminal.ansiCyan": "#79c0ff",
  "terminal.ansiWhite": "#e6edf3",
  "terminal.ansiBrightBlack": "#8b949e",
  "terminal.ansiBrightRed": "#ff7b72",
  "terminal.ansiBrightGreen": "#3fb950",
  "terminal.ansiBrightYellow": "#d29922",
  "terminal.ansiBrightBlue": "#58a6ff",
  "terminal.ansiBrightMagenta": "#bc8ef7",
  "terminal.ansiBrightCyan": "#79c0ff",
  "terminal.ansiBrightWhite": "#ffffff",

  // ============================================
  // EDITOR BEHAVIOR
  // ============================================
  "editor.minimap.enabled": true,
  "editor.minimap.maxColumn": 120,
  "editor.renderWhitespace": "selection",
  "editor.renderLineHighlight": "gutter",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.formatOnSave": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorWidth": 2,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },

  // ============================================
  // PROJECT-SPECIFIC SETTINGS
  // ============================================
  "files.associations": {
    "*.html": "html"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.vscode-typescript"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "files.exclude": {
    "node_modules": true,
    ".wrangler": true
  },
  "search.exclude": {
    "node_modules": true,
    ".wrangler": true
  },
  "html.format.wrapLineLength": 0,
  "html.format.wrapAttributes": "preserve",
  "css.lint.unknownAtRules": "ignore",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000
}
